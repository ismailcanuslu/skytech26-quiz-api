FRONTEND_IMAGE_NAME=ghcr.io/etubmt/quizetu-frontend
FRONTEND_IMAGE_TAG=latest
FRONTEND_CONTAINER_NAME=quizetu-frontend
FRONTEND_BUILD_CONTEXT=../quizetu
FRONTEND_DOCKERFILE=Dockerfile
FRONTEND_NODE_ENV=production
FRONTEND_INTERNAL_PORT=8080
FRONTEND_HOST=quiz.etubmt.com
NEXT_PUBLIC_API_URL=https://api.quiz.etubmt.com

BACKEND_IMAGE_NAME=ghcr.io/etubmt/kahoot-backend-api
BACKEND_IMAGE_TAG=latest
BACKEND_CONTAINER_NAME=kahoot-backend
BACKEND_DOCKERFILE=kahoot-backend/Dockerfile
BACKEND_ASPNETCORE_ENVIRONMENT=Production
BACKEND_INTERNAL_PORT=8080
BACKEND_HOST=api.quiz.etubmt.com

TRAEFIK_NETWORK=proxy-network
TRAEFIK_CERT_RESOLVER=myresolver
INTERNAL_NETWORK=quizetu-internal

POSTGRES_CONTAINER_NAME=kahoot-postgres
POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_DB=kahoot_backend
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

REDIS_CONTAINER_NAME=kahoot-redis
REDIS_IMAGE=redis:7-alpine
REDIS_PORT=6379

JWT_KEY=dev_only_super_secret_key_change_me
JWT_ISSUER=Kahoot.Backend
JWT_AUDIENCE=Kahoot.Client
JWT_ADMIN_EXPIRES_MIN=60
JWT_GUEST_EXPIRES_MIN=15

ADMIN_SEED_EMAIL=iletisim@etubmt.com
ADMIN_SEED_PASSWORD=QcnvskGe
